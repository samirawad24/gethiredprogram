# Copy this file to .env.local for local development.
# On GitHub Pages, set these as repository variables (see README).

# Public URL of the site including any subfolder, no trailing slash.
# Used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://gethiredprogram.com

# Subfolder the site lives in. Leave empty locally and on a custom domain.
# GitHub Pages project URL (samirawad24.github.io/gethiredprogram) needs /gethiredprogram
NEXT_PUBLIC_BASE_PATH=

# Cal.com booking link in the form "username/event-slug" (the part after cal.com/).
NEXT_PUBLIC_CAL_LINK=your-cal-username/free-consultation
