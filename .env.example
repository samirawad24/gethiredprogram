# Copy this file to .env.local for local development.
# On Vercel, add the same variables under Project Settings > Environment Variables.

# Public URL of the live site, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://gethiredprogram.com

# Cal.com booking link in the form "username/event-slug" (the part after cal.com/).
NEXT_PUBLIC_CAL_LINK=your-cal-username/free-consultation
